{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2a.gokite.ai/schemas/agreement-error-catalog/v1",
  "title": "Agreement error catalog",
  "description": "The normative error codes a conforming Runtime returns, with their retry semantics. retriable=false means retrying the identical request cannot succeed; fix the input or the state first. This file is the catalog; the wire shape that carries a code is AgreementDomainError (domain-error.schema.json), returned in JSON-RPC error.data under code -32010 (spec §7).",
  "type": "object",
  "errors": [
    { "code": "invalid_command_schema", "retriable": false, "description": "Command failed JSON Schema validation for its declared schema/version." },
    { "code": "unsupported_extension_version", "retriable": false, "description": "Extension or template version not supported; fails before agreement acceptance." },
    { "code": "invalid_signature", "retriable": false, "description": "Signature does not verify against the resolved actor key, profile, and domain-separation tag." },
    { "code": "unknown_key", "retriable": false, "description": "keyId does not resolve, or was not valid at command time." },
    { "code": "runtime_key_required", "retriable": false, "description": "Agreement acceptance did not identify both parties' concrete runtime keys through signatures[].keyId." },
    { "code": "runtime_not_found", "retriable": false, "description": "A selected runtime key does not resolve." },
    { "code": "runtime_pending", "retriable": true, "description": "A selected runtime exists but is pending owner approval; retry after its owner activates it." },
    { "code": "runtime_revoked", "retriable": false, "description": "A selected runtime was revoked permanently and cannot become Agreement authority; select a new runtime before acceptance." },
    { "code": "runtime_agent_mismatch", "retriable": false, "description": "A selected runtime key belongs to a different Agent DID." },
    { "code": "runtime_signature_mismatch", "retriable": false, "description": "An Agreement signature does not verify under the runtime key named by its signatures[].keyId entry." },
    { "code": "agreement_runtime_mismatch", "retriable": false, "description": "The request attempts to use a runtime key different from the authority already pinned to this Agreement." },
    { "code": "unauthorized_actor", "retriable": false, "description": "Actor is not a participant of the deal, or lacks authority for this command type." },
    { "code": "unknown_deal", "retriable": false, "description": "dealId does not resolve." },
    { "code": "terms_hash_mismatch", "retriable": false, "description": "Command's termsHash does not match the accepted contract." },
    { "code": "payload_hash_mismatch", "retriable": false, "description": "Runtime's independently recomputed payload hash differs from the claimed one." },
    { "code": "revision_conflict", "retriable": true, "description": "expectedRevision is stale; refetch state and resubmit with the current revision." },
    { "code": "idempotency_conflict", "retriable": false, "description": "commandId reused with different immutable bytes; rejected and audited." },
    { "code": "illegal_transition", "retriable": false, "description": "commandType is not legal from the deal's current state under the pinned template." },
    { "code": "deadline_exceeded", "retriable": false, "description": "The relevant platform window has elapsed; the deadline edge governs. RESERVED in this release: no Runtime emits it yet — the deadline refusal edge is not implemented; the code is pinned here so clients can branch on it when it ships." },
    { "code": "evidence_not_validated", "retriable": false, "description": "Referenced evidence manifest is missing or failed intake validation." },
    { "code": "funding_not_final", "retriable": true, "description": "Funding not yet at chain finality; broadcast is not finality. RESERVED in this release: no Runtime emits it yet — the engine does not name the code; the mapping on the Passport side is in place and activates the moment it does." },
    { "code": "rate_limited", "retriable": true, "description": "Too many requests; honor Retry-After." },
    { "code": "internal_error", "retriable": true, "description": "Transient Runtime failure; safe to retry idempotently with the same commandId." }
  ]
}
